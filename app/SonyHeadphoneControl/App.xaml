<Application x:Class="SonyHeadphoneControl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mica="clr-namespace:MicaWPF.Styles;assembly=MicaWPF"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:SonyHeadphoneControl"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- FluentFlyout's desktop theme stack. -->
                <mica:ThemeDictionary Theme="Auto" DesignModeTheme="Auto" />
                <mica:ControlsDictionary />
                <ui:ThemesDictionary Theme="Unknown" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="FlyoutFont">./Resources/Fonts/#Noto Sans SC, Microsoft YaHei UI, Segoe UI</FontFamily>
            <RadialGradientBrush x:Key="CoverGlowMask" GradientOrigin="0.2,0.5" Center="0.1,0.5" RadiusX="0.7" RadiusY="0.3">
                <GradientStop Color="Black" Offset="0" />
                <GradientStop Color="Transparent" Offset="0.75" />
            </RadialGradientBrush>

            <!-- Adapted from FluentFlyout's Cover Glow, with a paint-only layer so artwork never affects window size. -->
            <ControlTemplate x:Key="CoverGlowSurface" TargetType="ContentControl">
                <Grid x:Name="GlowGrid" ClipToBounds="True" Tag="{DynamicResource {x:Static SystemParameters.HighContrastKey}}">
                    <Border x:Name="AccentGlow" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.23"
                            Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" OpacityMask="{StaticResource CoverGlowMask}" />
                    <Border x:Name="ArtworkGlow" IsHitTestVisible="False" Opacity="0.59" RenderTransformOrigin="0.5,0.5"
                            OpacityMask="{StaticResource CoverGlowMask}">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding CoverArtwork, RelativeSource={RelativeSource AncestorType={x:Type local:FlyoutWindow}}}" />
                        </Border.Background>
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <BlurEffect Radius="50" RenderingBias="Performance" />
                        </Border.Effect>
                    </Border>
                    <ContentPresenter />
                </Grid>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding CoverArtwork, RelativeSource={RelativeSource AncestorType={x:Type local:FlyoutWindow}}}" Value="{x:Null}">
                        <Setter TargetName="ArtworkGlow" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="AccentGlow" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, ElementName=GlowGrid}" Value="True">
                        <Setter TargetName="ArtworkGlow" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="AccentGlow" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="FlyoutTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="21" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="13" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="Choice" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Margin" Value="0,0,5,5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Surface" CornerRadius="6" Padding="5,4"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
